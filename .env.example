# GEMINI_API_KEY: Optional (only needed if AI features are ever enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted (e.g. Render URL).
APP_URL="MY_APP_URL"

# NMH_DB_PATH: SQLite database file path. On Render, point to a mounted Persistent Disk (e.g. /var/data/nmh.db).
NMH_DB_PATH="./data/nmh.db"

# NMH_AUTHORIZED_MAIN_ADMIN_EMAIL: Backend-only authorized initial Main Admin email.
# Defaults to the temporary testing email on first boot and can be changed in Settings via owner OTP verification.
NMH_AUTHORIZED_MAIN_ADMIN_EMAIL=""

# ADMIN_SETUP_TOKEN: Recommended secret token required during the one-time Main Admin setup on public Render deployments.
ADMIN_SETUP_TOKEN=""

# SESSION_TTL_MS: Admin session lifetime in milliseconds (default: 28800000 = 8 hours).
SESSION_TTL_MS="28800000"

# COOKIE_SAMESITE: Cookie SameSite mode ("lax", "strict", or "none").
# On standalone Render HTTPS deployments, "lax" or "strict" is recommended.
COOKIE_SAMESITE="lax"

# REQUIRED FOR REAL 6-DIGIT LOGIN OTP & PASSWORD RECOVERY EMAIL DELIVERY (Resend):
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
